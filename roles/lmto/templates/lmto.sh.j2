# LMTO PATH helper (ubuntu-bootstrap) — installed as /etc/profile.d/lmto.sh
#
# Adds ~/bin and ~/bin/$LSYSTEM only. Do NOT source Intel setvars here:
# ~/.bashrc already does (AIR). Sourcing it in both places prints
# "setvars.sh has already been run" on login shells (e.g. WSL).
#
# Build/test tasks source setvars themselves after prepending these dirs
# so Intel's ifx stays ahead of the ~/bin/ifx directory.

export LSYSTEM="${LSYSTEM:-{{ lmto_lsystem }}}"
case ":${PATH}:" in
  *":${HOME}/bin:"*) ;;
  *) PATH="${HOME}/bin:${PATH}" ;;
esac
case ":${PATH}:" in
  *":${HOME}/bin/${LSYSTEM}:"*) ;;
  *) PATH="${HOME}/bin/${LSYSTEM}:${PATH}" ;;
esac
export PATH
